    {
      "parameters": {
        "jsCode": "// Handle obligations from Guardrail decision\nconst decision = $input.first().json;\nconst stageData = $input.last().json;\n\nif (decision.obligations && decision.obligations.length > 0) {\n  const obligations = decision.obligations;\n  \n  for (const obligation of obligations) {\n    if (obligation.type === 'emit_budget_usage') {\n      // Emit budget telemetry\n      console.log('Emitting budget telemetry:', obligation.data);\n    } else if (obligation.type === 'emit_provenance') {\n      // Handle provenance obligation\n      console.log('Emitting provenance:', obligation.data);\n    }\n  }\n}\n\nreturn {\n  processed: true,\n  obligations_count: decision.obligations ? decision.obligations.length : 0\n};"
      },
