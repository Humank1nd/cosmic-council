    {
      "parameters": {
        "jsCode": "// Build evaluation input for Guardrail Gateway\nconst stage = $input.first().json;\n\n// Get enterprise and squad names\nconst enterpriseNames = {\n  1: 'red', 2: 'orange', 3: 'yellow', 4: 'green', 5: 'blue', 6: 'purple'\n};\nconst squadNames = {\n  1: 'red', 2: 'orange', 3: 'yellow', 4: 'green', 5: 'blue', 6: 'purple'\n};\nconst passNames = {\n  1: 'decide', 2: 'validate', 3: 'reflect'\n};\n\nconst evalInput = {\n  agent: {\n    enterprise: enterpriseNames[stage.enterprise_id],\n    squad: squadNames[stage.squad_id],\n    pass: passNames[stage.pass_id],\n    stage_id: stage.stage_id,\n    stage_code: stage.code\n  },\n  resource: {\n    service: 'cosmic_council',\n    action: 'execute_stage',\n    stage: stage.code\n  },\n  context: {\n    run_id: stage.run_id,\n    stage_id: stage.stage_id,\n    run_context: stage.run_context || {},\n    policy_bundle: stage.policy_bundle,\n    timestamp: new Date().toISOString()\n  }\n};\n\nreturn {\n  stage_run_id: stage.stage_run_id,\n  run_id: stage.run_id,\n  stage_id: stage.stage_id,\n  eval_input: evalInput\n};"
      },
      "id": "build-eval-input",
      "name": "Build Eval Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
