    {
      "parameters": {
        "jsCode": "// Log reflection summary\nconst analysis = $input.first().json;\n\nconsole.log('Purple Elephant Reflection Summary:');\nconsole.log(`- Incident Rate: ${analysis.metrics.incident_rate.toFixed(2)}%`);\nconsole.log(`- False Block Rate: ${analysis.metrics.false_block_rate.toFixed(2)}%`);\nconsole.log(`- Average Latency: ${analysis.metrics.avg_latency.toFixed(0)}ms`);\nconsole.log(`- Critical Incidents: ${analysis.metrics.critical_incidents}`);\nconsole.log(`- Policy Evolution Needed: ${analysis.should_propose_evolution ? 'Yes' : 'No'}`);\n\nif (analysis.should_propose_evolution) {\n  console.log(`- Target Scopes: ${analysis.target_scopes.join(', ')}`);\n}\n\nreturn {\n  reflection_completed: true,\n  timestamp: new Date().toISOString()\n};"
      },
