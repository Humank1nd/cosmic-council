        "query": "SELECT COUNT(*) as total_incidents, COUNT(*) FILTER (WHERE severity = 'critical') as critical_incidents, COUNT(*) FILTER (WHERE severity = 'high') as high_incidents, COUNT(*) FILTER (WHERE created_at >= now() - interval '1 hour') as recent_incidents FROM incidents WHERE created_at >= now() - interval '24 hours'"
      },
      "id": "analyze-incidents",
      "name": "Analyze Incidents",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [460, 300],
      "credentials": {
        "postgres": {
          "id": "postgres-credentials",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as total_decisions, COUNT(*) FILTER (WHERE allow = false) as blocked_decisions, COUNT(*) FILTER (WHERE allow = true) as allowed_decisions, AVG(latency_ms) as avg_latency FROM decisions WHERE time >= now() - interval '24 hours'"
      },
      "id": "analyze-decisions",
      "name": "Analyze Decisions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [680, 300],
      "credentials": {
        "postgres": {
          "id": "postgres-credentials",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT enterprise, COUNT(*) as stage_failures, AVG(EXTRACT(EPOCH FROM (completed_at - attempted_at)) * 1000) as avg_duration FROM cycle_stage_runs csr JOIN cycle_stages cs ON csr.stage_id = cs.stage_id JOIN enterprises e ON cs.enterprise_id = e.enterprise_id WHERE csr.status = 'failed' AND csr.completed_at >= now() - interval '24 hours' GROUP BY enterprise"
      },
      "id": "analyze-stage-failures",
      "name": "Analyze Stage Failures",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [900, 300],
      "credentials": {
        "postgres": {
          "id": "postgres-credentials",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Analyze reflection metrics and determine if policy evolution is needed\nconst incidents = $input.first().json;\nconst decisions = $input.all()[1].json;\nconst stageFailures = $input.all()[2].json;\n\n// Calculate key metrics\nconst incidentRate = incidents.total_incidents > 0 ? (incidents.recent_incidents / incidents.total_incidents) * 100 : 0;\nconst falseBlockRate = decisions.total_decisions > 0 ? (decisions.blocked_decisions / decisions.total_decisions) * 100 : 0;\nconst avgLatency = decisions.avg_latency || 0;\n\n// Determine if policy evolution is needed\nconst needsEvolution = {\n  high_incident_rate: incidentRate > 5, // More than 5% incident rate\n  high_false_block: falseBlockRate > 10, // More than 10% false block rate\n  high_latency: avgLatency > 5000, // More than 5 second latency\n  critical_incidents: incidents.critical_incidents > 0\n};\n\nconst shouldProposeEvolution = Object.values(needsEvolution).some(Boolean);\n\n// Identify target scopes for evolution\nconst targetScopes = [];\nif (needsEvolution.high_incident_rate || needsEvolution.critical_incidents) {\n  targetScopes.push('guard/access');\n}\nif (needsEvolution.high_false_block) {\n  targetScopes.push('guard/brand');\n}\nif (needsEvolution.high_latency) {\n  targetScopes.push('guard/budget');\n}\n\nreturn {\n  metrics: {\n    incident_rate: incidentRate,\n    false_block_rate: falseBlockRate,\n    avg_latency: avgLatency,\n    total_incidents: incidents.total_incidents,\n    critical_incidents: incidents.critical_incidents\n  },\n  needs_evolution: needsEvolution,\n  should_propose_evolution: shouldProposeEvolution,\n  target_scopes: targetScopes,\n  analysis_timestamp: new Date().toISOString()\n};"
      },
      "id": "analyze-reflection-metrics",
      "name": "Analyze Reflection Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "should-evolve",
              "leftValue": "={{ $json.should_propose_evolution }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "evolution-needed-check",
      "name": "Evolution Needed Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "jsCode": "// Generate policy evolution proposals\nconst analysis = $input.first().json;\nconst proposals = [];\n\nfor (const scope of analysis.target_scopes) {\n  const proposal = {\n    target_scope: scope,\n    current_version: '1.0.0', // This would be dynamic in production\n    proposed_version: '1.1.0-monitor',\n    rationale: generateRationale(scope, analysis.needs_evolution),\n    impact_analysis: generateImpactAnalysis(scope, analysis.metrics),\n    status: 'proposed'\n  };\n  proposals.push(proposal);\n}\n\nfunction generateRationale(scope, needs) {\n  const rationales = [];\n  if (needs.high_incident_rate) rationales.push('High incident rate detected');\n  if (needs.high_false_block) rationales.push('High false block rate observed');\n  if (needs.high_latency) rationales.push('Performance degradation detected');\n  if (needs.critical_incidents) rationales.push('Critical incidents require immediate attention');\n  \n  return `Policy evolution needed for ${scope}: ${rationales.join(', ')}`;\n}\n\nfunction generateImpactAnalysis(scope, metrics) {\n  return {\n    expected_incident_reduction: Math.min(metrics.incident_rate * 0.3, 50),\n    expected_false_block_reduction: Math.min(metrics.false_block_rate * 0.2, 30),\n    expected_latency_improvement: Math.min(metrics.avg_latency * 0.1, 1000),\n    risk_level: metrics.critical_incidents > 0 ? 'high' : 'medium'\n  };\n}\n\nreturn { proposals };"
      },
      "id": "generate-proposals",
      "name": "Generate Proposals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 200]
