# Database configuration
POSTGRES_USER=cosmic_council
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=cosmic_council

DB_HOST=postgres
DB_PORT=5432
DB_NAME=cosmic_council
DB_USER=cosmic_council
DB_PASSWORD=change-me-in-production

# Development overrides
DEV_POSTGRES_USER=cosmic_council
DEV_POSTGRES_PASSWORD=change-me-for-dev
DEV_POSTGRES_DB=cosmic_council_dev

DEV_POSTGRES_PERPETUAL_USER=cosmic_council
DEV_POSTGRES_PERPETUAL_PASSWORD=change-me-for-perpetual-dev
DEV_POSTGRES_PERPETUAL_DB=cosmic_council_perpetual_dev

DEV_DATABASE_URL=postgresql://cosmic_council:change-me-for-dev@postgres-dev:5432/cosmic_council_dev
DEV_PERPETUAL_DATABASE_URL=postgresql://cosmic_council:change-me-for-perpetual-dev@postgres-perpetual-dev:5432/cosmic_council_perpetual_dev
DEV_REDIS_URL=redis://redis-dev:6379/0

# Application configuration
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-jwt
API_KEY=change-me
ENVIRONMENT=production
LOG_LEVEL=INFO

# AI/LLM configuration
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Monitoring configuration
GRAFANA_PASSWORD=your-grafana-password

# Security configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_TLS=true

# File upload configuration
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png,gif
UPLOAD_PATH=/app/uploads

# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION=30
BACKUP_PATH=/app/backups

# GitHub release workflow secrets
# Set these as GitHub Secrets when publishing releases or posting notifications
TWITTER_API_KEY=placeholder
TWITTER_API_SECRET=placeholder
TWITTER_ACCESS_TOKEN=placeholder
TWITTER_ACCESS_TOKEN_SECRET=placeholder
REDDIT_USERNAME=placeholder
REDDIT_PASSWORD=placeholder
REDDIT_APP_ID=placeholder
REDDIT_APP_SECRET=placeholder
