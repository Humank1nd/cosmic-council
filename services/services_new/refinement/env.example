# Cosmic Council Refinement Engine - Environment Configuration Example
# Copy this file to .env and update the values for your environment

# Database Configuration
DATABASE_URL=postgresql://cosmic_council:cosmic_password@localhost:5432/cosmic_council_db
REDIS_URL=redis://localhost:6379/0

# Security Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_SECRET=your-api-key-secret-change-in-production

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ENABLE_AI_SERVICES=true

# Monitoring Configuration
ENABLE_METRICS_SERVER=true
METRICS_PORT=9090
ENABLE_SENTRY=false
SENTRY_DSN=your-sentry-dsn
ENVIRONMENT=production
RELEASE=1.0.0

# Application Configuration
LOG_LEVEL=INFO
MAX_WORKERS=4
WORKER_TIMEOUT=300

# Grafana Configuration
GRAFANA_PASSWORD=admin

# SSL Configuration (for production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
