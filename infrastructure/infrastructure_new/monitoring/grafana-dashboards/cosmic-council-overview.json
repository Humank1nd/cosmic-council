{
  "title": "Cosmic Council Overview",
  "timezone": "browser",
  "panels": [
    {
      "type": "graph",
      "title": "Gateway Requests",
      "targets": [
        { "expr": "sum(rate(http_requests_total{job='gateway'}[5m]))" }
      ]
    },
    {
      "type": "graph",
      "title": "Analytics Requests",
      "targets": [
        { "expr": "sum(rate(http_requests_total{job='analytics'}[5m]))" }
      ]
    },
    {
      "type": "graph",
      "title": "Reflection Requests",
      "targets": [
        { "expr": "sum(rate(http_requests_total{job='reflection'}[5m]))" }
      ]
    }
  ]
}
